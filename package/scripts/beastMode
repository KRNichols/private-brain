#!/usr/bin/env bash
# Private Brain — thin Codex sideload launcher (NOT a separate product CLI).
#
# End users never run Python. Features are toggled by ARGUMENTS / env, then we
# exec codex (or exit after --ingest-only).
#
#   beastMode                         # headless beast (default)
#   beastMode -GodsEye                # + live GUI (GodsEye)
#   beastMode --godseye --swarm 32    # GUI + 32-agent shared-graph swarm
#   beastMode --swarm 16              # swarm without GUI
#   beastMode --nuclear               # danger-full-access extra flag
#   beastMode -ingestion URL          # polite recursive GitLab crawl → graph
#   beastMode -ingestion URL --max    # DEEP + generous limits (still rate-limited)
#   beastMode -ingestion gnome        # preset shortcut (gnome|salsa|gitlab|freexian)
#   beastMode --preset salsa --max    # same via --preset
#   beastMode -ingestion URL --ingest-only
#   beastMode --doctor                # health check → READY / FAIL (no codex)
#   beastMode --enterprise            # Corporate pilot profile (no public OSS, hard audit/cites)
#   beastMode --enterprise --sap-pack # SAP evidence zip under .brain/audit/packs/
#   beastMode --enterprise --heal     # self-recover profile/chain/vectors/snapshot
#
# Equivalent pure-codex forms:
#   codex --dangerously-bypass-hook-trust -p beast
#   codex --dangerously-bypass-hook-trust -p beast-godseye   # profile only — GUI needs beastMode -GodsEye

set -euo pipefail

export CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
export PRIVATE_BRAIN_HOME="${PRIVATE_BRAIN_HOME:-$CODEX_HOME/private-brain}"
export PATH="/Applications/ChatGPT.app/Contents/Resources:${PATH:-}"
# Keep heal/doctor JSON pipes clean (pygame support banner)
export PYGAME_HIDE_SUPPORT_PROMPT="${PYGAME_HIDE_SUPPORT_PROMPT:-1}"

# Defaults — ORGANISM always-on (water pipe). Not a flag dance.
# beastMode alone = enterprise + max agents + GodsEye prefer-on + water_pipe then Codex.
export PB_ENTERPRISE="${PB_ENTERPRISE:-1}"
export PB_GODSEYE="${PB_GODSEYE:-1}"
# max agents: 0/empty/auto → organism computes min(256, cpu*8)
# Product default: 16 shared-topology swarm agents (set 0 to disable)
export PB_SWARM_AGENTS="${PB_SWARM_AGENTS:-16}"
export PB_MAX_AGENTS="${PB_MAX_AGENTS:-auto}"
export PB_AWS_REGION="${PB_AWS_REGION:-gov-region-1}"
PROFILE="beast-enterprise"
ENTERPRISE=1
EXTRA_CODEX=()
PASSTHRU=()
INGEST_URL=""
INGEST_PRESET=""
INGEST_MAX=0
INGEST_ONLY=0
INGEST_SHALLOW=0
INGEST_MAX_PROJECTS=""
INGEST_EXTRA=()
SYNC_MEMORY=0
NOTE_TEXT=""
AUTO_SYNC=1
DOCTOR=0
# ENTERPRISE already 1 by default (always-on organism)
SAP_PACK=0
HEAL=0
PURITY_AUDIT=0
QUARANTINE_PUBLIC=0
VALIDATE_ENTERPRISE=0
MISSION=0
FIRE_DRILL=0
OPS_METRICS=0
AUTOPILOT=0
NO_AUTOPILOT=0
SHOW_GODSEYE=0
# LOOP→GRAPH→HARNESS pipeline (offline demo / brain fan-out / tests)
PIPELINE_MODE=""
# Never-forget second mind
NEVER_FORGET_INIT=0
INTERVIEW=0
ORGANIZE=0
PROJECT_NAME=""
PROJECT_GOAL=""
SKILL_NAME=""
SKILL_BODY=""
EXIT_AFTER_FEATURE=0

KNOWN_PRESETS="gnome|salsa|gitlab|freexian"

is_preset() {
  case "$1" in
    gnome|salsa|gitlab|freexian) return 0 ;;
    *) return 1 ;;
  esac
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -GodsEye|--GodsEye|--godseye|-godseye)
      export PB_GODSEYE=1
      # TRUE OpenGL by default (graph_gl.py + PyOpenGL). Override: PB_GODSEYE_BACKEND=cpu
      export PB_GODSEYE_BACKEND="${PB_GODSEYE_BACKEND:-gl}"
      PROFILE="beast-godseye"
      shift
      ;;
    --GodsEye-cpu|--godseye-cpu|--gui-cpu)
      export PB_GODSEYE=1
      export PB_GODSEYE_BACKEND=cpu
      PROFILE="beast-godseye"
      shift
      ;;
    --no-gui|--headless)
      export PB_GODSEYE=0
      PROFILE="beast"
      shift
      ;;
    --swarm)
      export PB_SWARM_AGENTS="${2:-32}"
      shift 2
      ;;
    --swarm=*)
      export PB_SWARM_AGENTS="${1#*=}"
      shift
      ;;
    -ingestion|--ingestion|--ingest)
      val="${2:-}"
      if [[ -z "$val" ]]; then
        echo "beastMode: -ingestion requires a URL or preset (gnome|salsa|gitlab|freexian)" >&2
        exit 2
      fi
      if is_preset "$val"; then
        INGEST_PRESET="$val"
      else
        INGEST_URL="$val"
      fi
      shift 2
      ;;
    -ingestion=*|--ingestion=*|--ingest=*)
      val="${1#*=}"
      if is_preset "$val"; then
        INGEST_PRESET="$val"
      else
        INGEST_URL="$val"
      fi
      shift
      ;;
    --preset)
      INGEST_PRESET="${2:-}"
      if [[ -z "$INGEST_PRESET" ]]; then
        echo "beastMode: --preset requires name: $KNOWN_PRESETS" >&2
        exit 2
      fi
      if ! is_preset "$INGEST_PRESET"; then
        echo "beastMode: unknown preset '$INGEST_PRESET' (want $KNOWN_PRESETS)" >&2
        exit 2
      fi
      shift 2
      ;;
    --preset=*)
      INGEST_PRESET="${1#*=}"
      if ! is_preset "$INGEST_PRESET"; then
        echo "beastMode: unknown preset '$INGEST_PRESET' (want $KNOWN_PRESETS)" >&2
        exit 2
      fi
      shift
      ;;
    --max|--max-ingest)
      INGEST_MAX=1
      shift
      ;;
    -colonoscopy|--colonoscopy)
      # Alias: -ingestion URL --max (full-depth polite harvest)
      val="${2:-}"
      if [[ -z "$val" ]]; then
        echo "beastMode: -colonoscopy requires a URL or preset" >&2
        exit 2
      fi
      if is_preset "$val"; then
        INGEST_PRESET="$val"
      else
        INGEST_URL="$val"
      fi
      INGEST_MAX=1
      shift 2
      ;;
    --shallow)
      INGEST_SHALLOW=1
      shift
      ;;
    --max-projects)
      INGEST_MAX_PROJECTS="${2:-}"
      if [[ -z "$INGEST_MAX_PROJECTS" ]]; then
        echo "beastMode: --max-projects requires N" >&2
        exit 2
      fi
      shift 2
      ;;
    --max-projects=*)
      INGEST_MAX_PROJECTS="${1#*=}"
      shift
      ;;
    --ingest-only)
      # run ingestion and exit (no codex) — still sideload tooling, not a product CLI
      INGEST_ONLY=1
      shift
      ;;
    --sync-memory|--sync-boss|--distill-sync)
      # one markdown vault → Codex skills + AGENTS (stop re-explaining yourself)
      SYNC_MEMORY=1
      shift
      ;;
    --note)
      NOTE_TEXT="${2:-}"
      if [[ -z "$NOTE_TEXT" ]]; then
        echo "beastMode: --note needs text (what worked / tell past-self)" >&2
        exit 2
      fi
      shift 2
      ;;
    --note=*)
      NOTE_TEXT="${1#*=}"
      shift
      ;;
    --no-auto-sync)
      AUTO_SYNC=0
      shift
      ;;
    --enterprise|-enterprise)
      ENTERPRISE=1
      export PB_ENTERPRISE=1
      PROFILE="beast-enterprise"
      # enterprise defaults: headless, no nuclear, swarm off unless user set it
      export PB_GODSEYE="${PB_GODSEYE:-0}"
      shift
      ;;
    --sap-pack|--sap|--audit-pack)
      SAP_PACK=1
      EXIT_AFTER_FEATURE=1
      shift
      ;;
    --heal|--self-heal|--repair)
      # Self-heal does NOT force enterprise — home heals free; Corporate uses --enterprise --heal
      HEAL=1
      EXIT_AFTER_FEATURE=1
      shift
      ;;
    --purity-audit|--corpus-purity)
      # reproducible public-host purity report (enterprise)
      ENTERPRISE=1
      export PB_ENTERPRISE=1
      EXIT_AFTER_FEATURE=1
      PURITY_AUDIT=1
      shift
      ;;
    --quarantine-public)
      ENTERPRISE=1
      export PB_ENTERPRISE=1
      EXIT_AFTER_FEATURE=1
      QUARANTINE_PUBLIC=1
      shift
      ;;
    --validate-enterprise|--e2e-enterprise)
      ENTERPRISE=1
      export PB_ENTERPRISE=1
      EXIT_AFTER_FEATURE=1
      VALIDATE_ENTERPRISE=1
      shift
      ;;
    --day1|--DAY1)
      ENTERPRISE=1
      export PB_ENTERPRISE=1
      EXIT_AFTER_FEATURE=1
      RUN_DAY1=1
      shift
      ;;
    --mission|--monday|--zero-fail)
      ENTERPRISE=1
      export PB_ENTERPRISE=1
      EXIT_AFTER_FEATURE=1
      MISSION=1
      shift
      ;;
    --fire-drill|--firedrill|--airtight)
      ENTERPRISE=1
      export PB_ENTERPRISE=1
      EXIT_AFTER_FEATURE=1
      FIRE_DRILL=1
      shift
      ;;
    --metrics|--ops-metrics)
      EXIT_AFTER_FEATURE=1
      OPS_METRICS=1
      shift
      ;;
    --autopilot|--alive|--wake|--organism|--water-pipe)
      ENTERPRISE=1
      export PB_ENTERPRISE=1
      EXIT_AFTER_FEATURE=1
      AUTOPILOT=1
      shift
      ;;
    --no-autopilot|--no-organism)
      NO_AUTOPILOT=1
      export PB_AUTOPILOT=0
      shift
      ;;
    --show-godseye|--godseye-show)
      export PB_GODSEYE=1
      export PB_GODSEYE_FORCE=1
      EXIT_AFTER_FEATURE=1
      SHOW_GODSEYE=1
      shift
      ;;
    --config-of-config|--coc|--board)
      ENTERPRISE=1
      export PB_ENTERPRISE=1
      EXIT_AFTER_FEATURE=1
      CONFIG_OF_CONFIG=1
      shift
      ;;
    --capabilities|--caps)
      EXIT_AFTER_FEATURE=1
      CAPABILITIES=1
      shift
      ;;
    --nuclear)
      if [[ "${PB_ENTERPRISE:-0}" == "1" || "$ENTERPRISE" == "1" ]]; then
        echo "beastMode: --nuclear blocked in enterprise mode" >&2
        exit 2
      fi
      EXTRA_CODEX+=(--dangerously-bypass-approvals-and-sandbox)
      shift
      ;;
    --no-lgh)
      # disable LOOP→GRAPH→HARNESS fan-out inside concert
      export PB_LGH=0
      shift
      ;;
    --lgh-concert)
      export PB_LGH=1
      export PB_LGH_WITH_SWARM=1
      shift
      ;;
    -p|--profile)
      # allow override but keep beast default
      PROFILE="${2:-beast}"
      shift 2
      ;;
    --doctor|-doctor)
      # handled after env resolve (needs CODEX_HOME / PRIVATE_BRAIN_HOME)
      DOCTOR=1
      shift
      ;;
    --pipeline|--lgh)
      # LOOP→GRAPH→HARNESS: demo | brain | test  (default demo; exits, no codex)
      if [[ "${2:-}" == "demo" || "${2:-}" == "brain" || "${2:-}" == "test" ]]; then
        PIPELINE_MODE="$2"
        shift 2
      else
        PIPELINE_MODE="demo"
        shift
      fi
      EXIT_AFTER_FEATURE=1
      ;;
    --pipeline=*|--lgh=*)
      PIPELINE_MODE="${1#*=}"
      EXIT_AFTER_FEATURE=1
      shift
      ;;
    --never-forget-init|--second-mind-init)
      NEVER_FORGET_INIT=1
      EXIT_AFTER_FEATURE=1
      shift
      ;;
    --interview)
      INTERVIEW=1
      EXIT_AFTER_FEATURE=1
      shift
      ;;
    --organize|--autopilot)
      ORGANIZE=1
      EXIT_AFTER_FEATURE=1
      shift
      ;;
    --project)
      PROJECT_NAME="${2:-}"
      if [[ -z "$PROJECT_NAME" ]]; then
        echo "beastMode: --project needs a name" >&2
        exit 2
      fi
      shift 2
      EXIT_AFTER_FEATURE=1
      ;;
    --project=*)
      PROJECT_NAME="${1#*=}"
      EXIT_AFTER_FEATURE=1
      shift
      ;;
    --goal)
      PROJECT_GOAL="${2:-}"
      shift 2
      ;;
    --goal=*)
      PROJECT_GOAL="${1#*=}"
      shift
      ;;
    --skill)
      SKILL_NAME="${2:-}"
      if [[ -z "$SKILL_NAME" ]]; then
        echo "beastMode: --skill needs a name" >&2
        exit 2
      fi
      shift 2
      EXIT_AFTER_FEATURE=1
      ;;
    --skill=*)
      SKILL_NAME="${1#*=}"
      EXIT_AFTER_FEATURE=1
      shift
      ;;
    --skill-body)
      SKILL_BODY="${2:-}"
      shift 2
      ;;
    --skill-body=*)
      SKILL_BODY="${1#*=}"
      shift
      ;;
    -h|--help)
      cat <<'EOF'
Private Brain sideload launcher → always ends in: codex -p <profile>

  beastMode [features] [codex args...]

You never run Python. Only beastMode / SETUP / UNINSTALL.
This is a Codex sideload — NOT a separate product CLI.

Features (arguments — all optional, default OFF):
  -GodsEye | --godseye       TRUE OpenGL GodsEye (pygame + PyOpenGL)
  --GodsEye-cpu              Software pygame dashboard (live_gui) instead of GL
  --no-gui                   Force headless (default)
  --swarm N | --swarm=N      Shared-topology multi-agent sweep (e.g. 32)
  -ingestion URL|PRESET      GitLab URL or preset → recursive knowledge harvest
  -colonoscopy URL|PRESET    Same as -ingestion … --max (full tree tear-down)
  --max                      DEEP + generous capture limits (still polite)
  --shallow / --max-projects N   Smoke / faster harvest
  --ingest-only              Harvest then exit (no Codex)
  --sync-memory              Distill vault → Codex skills/AGENTS (the "boss brain")
  --note "text"              Daily distill: what worked / tell past-self
  --no-auto-sync             Skip auto skill sync on launch
  --nuclear                  Extra danger-full-access on codex (blocked under --enterprise)
  --enterprise               Corporate/corporate mode: beast-enterprise profile, no public OSS
  --sap-pack                 Write SAP evidence zip (.brain/audit/packs/) then exit
  --heal                     Self-recover: capabilities + profile + tree + chain + vectors + snapshot
                             (home: free optional pip; Corporate: set --enterprise + PIP_INDEX_URL or degrade)
  --capabilities             Probe optional modules / GPU path; set PB_CAPS_HEAL=1 to install missing
  --purity-audit             Reproducible public-host corpus purity report (+ audit log)
  --quarantine-public        Tag public OSS hosts (exclude from preferred retrieve)
  --validate-enterprise      Multi-agent E2E: lint→swarm→concert→quarantine→purity×3→retrieve→reindex→audit→doctor→sap
  --config-of-config         Scripted inventory of agents/AppGate/AWS/SSM (before Day-1 intelligence)
  --day1                     ONE Day-1: map → sessions → heal → mission gates → optional crawl
  --mission                  Monday zero-fail gates (LOCAL_READY → OPS → AWS SHIM)
  --fire-drill               Dual-OS airtight smoke (Mac live + Windows static + heal×2)
  --metrics | --ops-metrics  Ops scoreboard → .brain/state/ops_metrics.json (graph/vectors/purity/audit/GodsEye)
  --autopilot | --alive | --organism   Water-pipe only (sessions→map→local→AWS→alive)
  --no-autopilot             Skip organism wake (rare)
  --doctor                   Forensics only
  -p NAME                    Codex profile override

  DEFAULT (no flags): beastMode = maximum agent deployment + GodsEye prefer-on +
  organism water-pipe (sessions, heal, crawl, swarm, AWS) then open Codex.
  You should almost never type --heal/--doctor/--mission by hand.

  Corporate deps: set PIP_INDEX_URL / corporate-package-index.env (Corporate Library) — see CORPORATE_PACKAGE_INDEX.md

  LOOP → GRAPH → HARNESS (exits; no codex unless you omit exit modes):
  --pipeline [demo|brain|test]   Offline demo / RAG fan-out / unit tests
  --lgh …                        Alias for --pipeline

  Never-forgets second mind (plain-text vault you own):
  --never-forget-init        Create vault/IDENTITY.md + projects/ + skills/
  --interview                Print one-question-at-a-time identity brief
  --project NAME [--goal …]  Create+activate Inputs/Process/Outputs/Feedback
  --skill NAME --skill-body  Save reusable skill under vault/skills/
  --organize                 Daily autopilot: file Inputs, flag stale, summary

Self-recovery (automatic): hooks, beast profiles, .brain tree, python runtime.

Examples:
  beastMode
  beastMode --doctor
  beastMode --enterprise
  beastMode --enterprise --doctor
  beastMode --enterprise --heal
  beastMode --enterprise --sap-pack
  beastMode --enterprise -ingestion https://gitlab.internal/group --ingest-only
  beastMode -GodsEye
  beastMode -colonoscopy https://gitlab.gnome.org/GNOME
  beastMode --note "Tried X. Worked. Tell past-me: Y" --sync-memory
  beastMode --swarm 32 "explain kafka controllers"
  beastMode --pipeline
  beastMode --pipeline brain -- " "   # (pipeline exits; use alone)
  beastMode --never-forget-init
  beastMode --interview
  beastMode --project youtube-channel --goal "Ship weekly videos"
  beastMode --organize

See README.md — Distill vault / Never-forgets / LOOP-GRAPH-HARNESS
EOF
      exit 0
      ;;
    *)
      PASSTHRU+=("$1")
      shift
      ;;
  esac
done

# ── Resolve python (venv preferred; never ask user to type python) ──
resolve_py() {
  local candidates=(
    "$PRIVATE_BRAIN_HOME/venv/bin/python3"
    "$PRIVATE_BRAIN_HOME/venv/bin/python"
    "$PRIVATE_BRAIN_HOME/venv/Scripts/python.exe"
  )
  local c
  for c in "${candidates[@]}"; do
    if [[ -x "$c" ]] && "$c" -c "import sys" >/dev/null 2>&1; then
      echo "$c"
      return 0
    fi
  done
  if command -v python3 >/dev/null 2>&1 && python3 -c "import sys" >/dev/null 2>&1; then
    command -v python3
    return 0
  fi
  if command -v python >/dev/null 2>&1 && python -c "import sys" >/dev/null 2>&1; then
    command -v python
    return 0
  fi
  if command -v py >/dev/null 2>&1; then
    echo "py"
    return 0
  fi
  echo ""
  return 1
}

PY="$(resolve_py || true)"
if [[ -z "$PY" ]]; then
  echo "beastMode: no usable python found (venv broken and no python3/py on PATH)" >&2
  echo "  Re-run SETUP.command / SETUP.ps1 to recreate the private-brain venv." >&2
  if [[ "$DOCTOR" == "1" ]]; then
    echo ""
    echo "FAIL — no usable python runtime for brain/chain checks"
    echo "  Fix: re-run SETUP.command (or SETUP.ps1 on Windows)"
    exit 1
  fi
  if [[ "$INGEST_ONLY" == "1" ]] || [[ -n "$INGEST_URL" || -n "$INGEST_PRESET" || -n "${PB_INGEST_URL:-}" ]]; then
    exit 1
  fi
fi

# scripts + package root (loop_graph_harness is a package under private-brain/)
export PYTHONPATH="${PRIVATE_BRAIN_HOME}/scripts:${PRIVATE_BRAIN_HOME}${PYTHONPATH:+:$PYTHONPATH}"

# ── Load Corporate env early (corporate-package-index index + program stamps) ──
for envf in \
  "$PRIVATE_BRAIN_HOME/corporate.env" \
  "$PRIVATE_BRAIN_HOME/corporate-package-index.env" \
  "$HOME/.codex/corporate-package-index.env"
do
  if [[ -f "$envf" ]]; then
    set +u
    while IFS= read -r line || [[ -n "$line" ]]; do
      case "$line" in
        ''|\#*) continue ;;
        export\ *)
          # ZERO SOFT / safe: parse KEY=VALUE without eval
          rest="${line#export }"
          key="${rest%%=*}"
          val="${rest#*=}"
          key="${key// /}"
          # strip surrounding quotes
          if [[ "$val" == \"*\" ]]; then val="${val:1:${#val}-2}"; fi
          if [[ "$val" == \'*\' ]]; then val="${val:1:${#val}-2}"; fi
          if [[ -n "$key" && "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            export "$key=$val" 2>/dev/null || true
          fi
          ;;
      esac
    done < "$envf"
    set -u
  fi
done

# ── doctor: human health report (READY / FAIL). User never types python. ──
run_doctor() {
  local fail=0
  local ok_mark="OK"
  local bad_mark="FAIL"
  local line detail
  local SCRIPTS="$PRIVATE_BRAIN_HOME/scripts"
  local required_scripts=(
    brain_lib.py
    audit_lib.py
    orchestrate.py
    enterprise.py
    vector_manager.py
    smart_discover.py
    gitlab_ingest.py
    distill_vault.py
    agent_swarm.py
    godseye.py
    second_mind.py
    uninstall_private_brain.py
    install_hooks.py
    beastMode
  )
  local s missing=()

  echo "Private Brain doctor"
  echo "  CODEX_HOME=$CODEX_HOME"
  echo "  PRIVATE_BRAIN_HOME=$PRIVATE_BRAIN_HOME"
  echo ""

  # hooks.json
  if [[ -f "$CODEX_HOME/hooks.json" ]]; then
    echo "  [$ok_mark] hooks.json          $CODEX_HOME/hooks.json"
  else
    echo "  [$bad_mark] hooks.json          missing — run SETUP.command or beastMode once to recover"
    fail=1
  fi

  # beast.config.toml
  if [[ -f "$CODEX_HOME/beast.config.toml" ]]; then
    echo "  [$ok_mark] beast.config.toml   $CODEX_HOME/beast.config.toml"
  else
    echo "  [$bad_mark] beast.config.toml   missing — run SETUP.command or beastMode once to recover"
    fail=1
  fi

  # private-brain home
  if [[ -d "$PRIVATE_BRAIN_HOME" ]]; then
    echo "  [$ok_mark] private-brain       $PRIVATE_BRAIN_HOME"
  else
    echo "  [$bad_mark] private-brain       missing — re-run SETUP.command"
    fail=1
  fi

  # scripts inventory
  if [[ ! -d "$SCRIPTS" ]]; then
    echo "  [$bad_mark] scripts             directory missing: $SCRIPTS"
    fail=1
  else
    for s in "${required_scripts[@]}"; do
      if [[ ! -e "$SCRIPTS/$s" ]]; then
        missing+=("$s")
      fi
    done
    # visualizers
    if [[ ! -f "$PRIVATE_BRAIN_HOME/visualizer/live_gui.py" ]]; then
      missing+=("visualizer/live_gui.py")
    fi
    if [[ ! -f "$PRIVATE_BRAIN_HOME/visualizer/graph_gl.py" ]]; then
      missing+=("visualizer/graph_gl.py")
    fi
    if [[ ! -f "$PRIVATE_BRAIN_HOME/loop_graph_harness/pipeline.py" ]]; then
      missing+=("loop_graph_harness/pipeline.py")
    fi
    if [[ ${#missing[@]} -eq 0 ]]; then
      echo "  [$ok_mark] scripts             ${#required_scripts[@]} core + live_gui + LGH present"
    else
      echo "  [$bad_mark] scripts             missing: ${missing[*]}"
      fail=1
    fi
  fi

  # node_count + chain_ok (internal python only — never shown as a user command)
  local node_count=0
  local chain_ok="false"
  local chain_events="0"
  local brain_err=""
  if [[ -n "$PY" ]]; then
    detail="$(
      CODEX_HOME="$CODEX_HOME" PRIVATE_BRAIN_HOME="$PRIVATE_BRAIN_HOME" \
      PYTHONPATH="$SCRIPTS${PYTHONPATH:+:$PYTHONPATH}" \
        "$PY" - <<'PY' 2>/dev/null || true
import sys
from pathlib import Path
import os
sys.path.insert(0, str(Path(os.environ.get("PRIVATE_BRAIN_HOME", "")) / "scripts"))
node_count = 0
chain_ok = "false"
events = 0
err = ""
try:
    from brain_lib import status
    st = status() or {}
    node_count = int(st.get("node_count") or 0)
except Exception as e:
    err = "status:" + str(e)[:120]
try:
    from audit_lib import verify_chain
    ch = verify_chain() or {}
    chain_ok = "true" if ch.get("ok") else "false"
    events = int(ch.get("events_checked") or 0)
except Exception as e:
    err = (err + " " if err else "") + "chain:" + str(e)[:120]
# machine line for bash (no JSON parse needed)
print(f"NODE={node_count}")
print(f"CHAIN={chain_ok}")
print(f"EVENTS={events}")
print(f"ERR={err}")
PY
    )"
    if [[ -n "$detail" ]]; then
      node_count="$(printf '%s\n' "$detail" | sed -n 's/^NODE=//p' | head -1)"
      chain_ok="$(printf '%s\n' "$detail" | sed -n 's/^CHAIN=//p' | head -1)"
      chain_events="$(printf '%s\n' "$detail" | sed -n 's/^EVENTS=//p' | head -1)"
      brain_err="$(printf '%s\n' "$detail" | sed -n 's/^ERR=//p' | head -1)"
      node_count="${node_count:-0}"
      chain_ok="${chain_ok:-false}"
      chain_events="${chain_events:-0}"
    else
      brain_err="brain probe failed"
    fi
  else
    brain_err="no python runtime"
  fi

  if [[ -n "$brain_err" && "${node_count:-0}" -eq 0 && "$chain_ok" != "true" ]]; then
    echo "  [$bad_mark] node_count          could not read ($brain_err)"
    echo "  [$bad_mark] chain_ok            could not verify ($brain_err)"
    fail=1
  else
    if [[ "${node_count:-0}" -gt 0 ]]; then
      echo "  [$ok_mark] node_count          $node_count (>0)"
    else
      echo "  [$bad_mark] node_count          ${node_count:-0} (need >0 — run ingestion or SETUP seed)"
      fail=1
    fi
    if [[ "$chain_ok" == "true" ]]; then
      echo "  [$ok_mark] chain_ok            true (events=$chain_events)"
    else
      echo "  [$bad_mark] chain_ok            false (events=$chain_events)${brain_err:+ — $brain_err}"
      fail=1
    fi
  fi

  # Enterprise extras when PB_ENTERPRISE=1 or --enterprise was set
  if [[ "${PB_ENTERPRISE:-0}" == "1" || "${ENTERPRISE:-0}" == "1" ]]; then
    echo ""
    echo "  Enterprise checks:"
    if [[ -n "$PY" ]]; then
      ent_out="$(
        CODEX_HOME="$CODEX_HOME" PRIVATE_BRAIN_HOME="$PRIVATE_BRAIN_HOME" PB_ENTERPRISE=1 \
        PYTHONPATH="$SCRIPTS${PYTHONPATH:+:$PYTHONPATH}" \
          "$PY" "$SCRIPTS/enterprise.py" doctor 2>/dev/null || true
      )"
      if [[ -n "$ent_out" ]]; then
        ent_rc="$(
        printf '%s\n' "$ent_out" | "$PY" -c "
import sys, json
try:
    d=json.load(sys.stdin)
except Exception:
    print('  [FAIL] enterprise doctor parse')
    print('HARD=1')
    raise SystemExit(0)
# Soft checks: unknown/not-configured Corporate paths must not hard-fail home-dev
soft = {
    'corpus_public_ratio', 'corpus_pilot_ready',
    'corporate_library_approved_source', 'optional_capabilities',
}
if not d.get('enterprise'):
    soft.add('corpus_pilot_ops')
hard = 0
for c in d.get('checks') or []:
    name = c.get('name') or ''
    if c.get('ok'):
        mark = 'OK'
    elif name in soft:
        mark = 'WARN'  # soft / unknown-not-fail
    else:
        mark = 'FAIL'
        hard = 1
    print(f\"  [{mark}] {name:<22} {c.get('detail','')}\")
print(f\"  program_id={d.get('program_id')} classification={d.get('classification')}\")
print(f'HARD={hard}')
" 2>/dev/null || { echo "  [WARN] enterprise doctor could not run"; echo "HARD=0"; }
        )"
        printf '%s\n' "$ent_rc" | sed '/^HARD=/d'
        ent_hard="$(printf '%s\n' "$ent_rc" | sed -n 's/^HARD=//p' | tail -1)"
        if [[ "${ent_hard:-0}" == "1" ]]; then
          fail=1
        fi
        # fail doctor if enterprise profile missing
        if [[ ! -f "$CODEX_HOME/beast-enterprise.config.toml" ]]; then
          echo "  [FAIL] beast-enterprise.config.toml missing"
          fail=1
        fi
      fi
    fi
  fi

  echo ""
  if [[ "$fail" -eq 0 ]]; then
    echo "READY"
    return 0
  fi
  echo "FAIL"
  echo "  Fix: re-run SETUP.command, then: beastMode --doctor"
  return 1
}

if [[ "$DOCTOR" == "1" ]]; then
