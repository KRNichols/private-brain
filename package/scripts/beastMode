import os, sys
from pathlib import Path
sys.path.insert(0, str(Path(os.environ["PRIVATE_BRAIN_HOME"]) / "scripts"))
os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
try:
    from capabilities import apply_env_hints, probe, write_state
    r = probe()
    write_state(r)
    apply_env_hints(r)  # sets PB_GODSEYE_BACKEND / PB_LAYOUT_ACCEL from importable modules
except Exception:
    pass
PY
