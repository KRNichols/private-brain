# ── Self-recovery: hooks.json ──
recover_hooks() {
  echo "beastMode: recovering hooks.json" >&2
  local ih="$PRIVATE_BRAIN_HOME/scripts/install_hooks.py"
  if [[ -n "$PY" && -f "$ih" ]]; then
    CODEX_HOME="$CODEX_HOME" PRIVATE_BRAIN_HOME="$PRIVATE_BRAIN_HOME" \
      "$PY" "$ih" >/dev/null 2>&1 && return 0
  fi
  # Minimal hooks pointing at private-brain/hooks (user never types python)
  mkdir -p "$PRIVATE_BRAIN_HOME/hooks" "$CODEX_HOME"
  local hook_py="${PY:-python3}"
  local ss="$PRIVATE_BRAIN_HOME/hooks/session_start.py"
  local ups="$PRIVATE_BRAIN_HOME/hooks/user_prompt_submit.py"
  local stop="$PRIVATE_BRAIN_HOME/hooks/stop_validate.py"
  cat > "$CODEX_HOME/hooks.json" <<JSON
{
  "description": "Private Brain RAG-DAG auto boot (recovered)",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${hook_py} ${ss}",
            "timeout": 120,
            "statusMessage": "Private Brain RAG-DAG boot"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${hook_py} ${ups}",
            "timeout": 180,
            "statusMessage": "Private Brain retrieve DAG"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${hook_py} ${stop}",
            "timeout": 30,
            "statusMessage": "Private Brain answer validator"
          }
        ]
      }
    ]
  }
}
JSON
  cp "$CODEX_HOME/hooks.json" "$PRIVATE_BRAIN_HOME/hooks/hooks.json" 2>/dev/null || true
}

if [[ ! -f "$CODEX_HOME/hooks.json" ]]; then
  recover_hooks
fi

