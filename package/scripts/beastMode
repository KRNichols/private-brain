  export PB_GODSEYE="${PB_GODSEYE:-1}"
  echo "beastMode: waking ORGANISM (water pipe · max agents · GodsEye prefer-on)…" >&2
  if [[ -f "$PRIVATE_BRAIN_HOME/scripts/organism.py" ]]; then
    # Full water-pipe first boot / force; light tick if recently alive (still heals+sessions)
    light="${PB_ORGANISM_LIGHT:-0}"
    if [[ "$light" != "1" && -f "$PRIVATE_BRAIN_HOME/.brain/state/organism.json" ]]; then
      # auto-light if organism report < 2h old
      if "$PY" -c "
import json,time
from pathlib import Path
p=Path(r'''$PRIVATE_BRAIN_HOME''')/'.brain/state/organism.json'
import sys
try:
  age=time.time()-p.stat().st_mtime
  d=json.loads(p.read_text())
  sys.exit(0 if age<7200 and d.get('alive') else 1)
except Exception:
  sys.exit(1)
" 2>/dev/null; then
        light=1
      fi
    fi
    if [[ "$light" == "1" ]]; then
      "$PY" "$PRIVATE_BRAIN_HOME/scripts/organism.py" --quiet --no-swarm --no-crawl --no-force-sessions 2>/dev/null || true
    else
      "$PY" "$PRIVATE_BRAIN_HOME/scripts/organism.py" --quiet 2>/dev/null || true
    fi
  elif [[ -f "$PRIVATE_BRAIN_HOME/scripts/autopilot.py" ]]; then
    "$PY" "$PRIVATE_BRAIN_HOME/scripts/autopilot.py" --quiet 2>/dev/null || true
  fi
  mkdir -p "$PRIVATE_BRAIN_HOME/.brain/state" 2>/dev/null || true
  : > "$PRIVATE_BRAIN_HOME/.brain/state/enterprise.on" 2>/dev/null || true
  : > "$PRIVATE_BRAIN_HOME/.brain/state/beastmode.on" 2>/dev/null || true
fi

# Resolve codex binary (not needed for --ingest-only)
CODEX_BIN="${CODEX_BIN:-}"
if [[ "$INGEST_ONLY" != "1" ]]; then
  if [[ -z "$CODEX_BIN" ]]; then
    if [[ -x /Applications/ChatGPT.app/Contents/Resources/codex ]]; then
      CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
    elif command -v codex >/dev/null 2>&1; then
      CODEX_BIN="$(command -v codex)"
    else
      echo "codex not found — install Codex CLI first" >&2
      exit 1
    fi
  fi
fi

# Feature: selective ingestion — prefer unified ingest_url router (GitLab/Jira/Confluence)
# Everything lands on shared graph via ingest_bus (tag / rate / vectorize).
if [[ -n "${INGEST_URL}" || -n "${INGEST_PRESET}" || -n "${PB_INGEST_URL:-}" ]]; then
  INGEST_URL_PY="$PRIVATE_BRAIN_HOME/scripts/ingest_url.py"
  INGEST_GL="$PRIVATE_BRAIN_HOME/scripts/gitlab_ingest.py"
  if [[ -f "$INGEST_URL_PY" ]]; then
    INGEST="$INGEST_URL_PY"
    USE_URL_ROUTER=1
  elif [[ -f "$INGEST_GL" ]]; then
    INGEST="$INGEST_GL"
    USE_URL_ROUTER=0
  else
    echo "beastMode: ingest_url.py / gitlab_ingest.py missing under $PRIVATE_BRAIN_HOME/scripts" >&2
    exit 1
  fi
  if [[ -z "$PY" ]]; then
    echo "beastMode: cannot ingest without python" >&2
    exit 1
  fi

  # Enterprise: block public presets / hosts before crawling
  if [[ "${PB_ENTERPRISE:-0}" == "1" ]]; then
    chk_args=()
    if [[ -n "$INGEST_PRESET" ]]; then
      chk_args+=(--preset "$INGEST_PRESET")
    else
      chk_args+=(--url "${INGEST_URL:-$PB_INGEST_URL}")
    fi
    if ! "$PY" "$PRIVATE_BRAIN_HOME/scripts/enterprise.py" check-ingest "${chk_args[@]}"; then
      echo "beastMode: enterprise policy blocked this ingestion" >&2
      exit 2
    fi
  fi

  # Always DEEP + verbose progress by default; --max raises limits further
  if [[ "${USE_URL_ROUTER}" == "1" ]]; then
    INGEST_ARGS=(--json)
  else
    INGEST_ARGS=(--deep --verbose --json)
  fi
  if [[ -n "$INGEST_PRESET" ]]; then
    INGEST_ARGS+=(--preset "$INGEST_PRESET")
    echo "Private Brain ingestion preset: $INGEST_PRESET" >&2
  else
    URL="${INGEST_URL:-$PB_INGEST_URL}"
    export PB_INGEST_URL="$URL"
    INGEST_ARGS+=(--url "$URL")
    echo "Private Brain ingestion: $URL" >&2
  fi
  if [[ "$INGEST_MAX" == "1" ]]; then
    INGEST_ARGS+=(--max)
    echo "Private Brain ingestion: MAX capture (deep + generous limits, still polite)" >&2
  fi
  if [[ "$INGEST_SHALLOW" == "1" && "${USE_URL_ROUTER}" != "1" ]]; then
    INGEST_ARGS+=(--shallow)
  fi
  if [[ -n "$INGEST_MAX_PROJECTS" && "${USE_URL_ROUTER}" != "1" ]]; then
    INGEST_ARGS+=(--max-projects "$INGEST_MAX_PROJECTS")
  fi
  # Prefer explicit --token; gitlab_ingest also reads GITLAB_TOKEN env
  if [[ -n "${GITLAB_TOKEN:-}" ]]; then
    INGEST_ARGS+=(--token "$GITLAB_TOKEN")
  fi

  set +e
  "$PY" "$INGEST" "${INGEST_ARGS[@]}"
  INGEST_EC=$?
  set -e
  if [[ "$INGEST_EC" -ne 0 ]]; then
    echo "beastMode: ingestion finished with errors (exit $INGEST_EC; continuing to codex unless --ingest-only)" >&2
  fi
  if [[ "$INGEST_ONLY" == "1" ]]; then
    echo "beastMode: --ingest-only done" >&2
    exit "$INGEST_EC"
  fi
fi

# Feature: NEVER-FORGET second mind (plain vault identity / projects / skills)
SM="$PRIVATE_BRAIN_HOME/scripts/second_mind.py"
if [[ -n "$PY" && -f "$SM" ]]; then
  if [[ "$NEVER_FORGET_INIT" == "1" ]]; then
    echo "beastMode: never-forget second mind init" >&2
    "$PY" "$SM" init 2>&1 | head -20 >&2 || true
  fi
  if [[ "$INTERVIEW" == "1" ]]; then
    echo "beastMode: identity interview prompt (paste into Codex next session)" >&2
    "$PY" "$SM" interview 2>&1 || true
  fi
  if [[ -n "$PROJECT_NAME" ]]; then
    echo "beastMode: project $PROJECT_NAME" >&2
    SM_ARGS=(project --name "$PROJECT_NAME")
    if [[ -n "$PROJECT_GOAL" ]]; then
      SM_ARGS+=(--goal "$PROJECT_GOAL")
    fi
    "$PY" "$SM" "${SM_ARGS[@]}" 2>&1 | head -25 >&2 || true
    SYNC_MEMORY=1
  fi
  if [[ -n "$SKILL_NAME" ]]; then
    if [[ -z "$SKILL_BODY" ]]; then
      echo "beastMode: --skill needs --skill-body \"steps...\"" >&2
      exit 2
    fi
    echo "beastMode: skill $SKILL_NAME" >&2
    "$PY" "$SM" skill --name "$SKILL_NAME" --body "$SKILL_BODY" 2>&1 | head -15 >&2 || true
  fi
  if [[ "$ORGANIZE" == "1" ]]; then
    echo "beastMode: organize autopilot (Inputs→Process, stale flags)" >&2
    "$PY" "$SM" organize 2>&1 | head -30 >&2 || true
  fi
fi

# Feature: LOOP → GRAPH → HARNESS pipeline (exits — proof of isolation stack)
if [[ -n "$PIPELINE_MODE" ]]; then
  if [[ -z "$PY" ]]; then
    echo "beastMode: --pipeline needs python runtime" >&2
    exit 1
  fi
  export PYTHONPATH="${PRIVATE_BRAIN_HOME}/scripts:${PRIVATE_BRAIN_HOME}${PYTHONPATH:+:$PYTHONPATH}"
  echo "beastMode: LOOP→GRAPH→HARNESS mode=$PIPELINE_MODE" >&2
  set +e
  case "$PIPELINE_MODE" in
    demo)  "$PY" -m loop_graph_harness.pipeline demo ;;
    brain)
      PROMPT_LGH="${PASSTHRU[*]:-kafka resilience}"
      "$PY" -m loop_graph_harness.pipeline brain --prompt "$PROMPT_LGH" --slices 4
      ;;
    test)  "$PY" -m loop_graph_harness.pipeline test ;;
    *)     "$PY" -m loop_graph_harness.pipeline demo ;;
  esac
  PIPE_EC=$?
  set -e
  exit "$PIPE_EC"
fi

# Feature: DISTILL VAULT — one markdown boss brain → Codex skills (never re-explain)
DISTILL="$PRIVATE_BRAIN_HOME/scripts/distill_vault.py"
if [[ -n "$PY" && -f "$DISTILL" ]]; then
  if [[ -n "$NOTE_TEXT" ]]; then
    "$PY" "$DISTILL" note --text "$NOTE_TEXT" >/dev/null 2>&1 || true
    echo "beastMode: distill note saved under vault/distill/" >&2
    SYNC_MEMORY=1
  fi
  if [[ "$SYNC_MEMORY" == "1" ]] || { [[ "$AUTO_SYNC" == "1" ]] && [[ ! -f "$CODEX_HOME/skills/private-brain/SKILL.md" ]]; }; then
    echo "beastMode: syncing distill vault → Codex skills/AGENTS (boss brain)" >&2
    "$PY" "$DISTILL" sync 2>/dev/null | head -15 >&2 || true
  fi
  if [[ "$SYNC_MEMORY" == "1" && "$INGEST_ONLY" == "1" && -z "$INGEST_URL" && -z "$INGEST_PRESET" && -z "${PB_INGEST_URL:-}" ]]; then
    echo "beastMode: --sync-memory done" >&2
    exit 0
  fi
fi

# Feature-only exit (never-forget / organize / interview without codex)
if [[ "$EXIT_AFTER_FEATURE" == "1" && "$INGEST_ONLY" != "1" ]]; then
  # still allow --sync-memory above; then leave without codex
  if [[ "$SYNC_MEMORY" == "1" && -n "$PY" && -f "$DISTILL" ]]; then
    true
  fi
  echo "beastMode: feature done (no codex — sideload tools only)" >&2
  exit 0
fi

# Feature: GodsEye GUI — only when arg/env says so; clear dismiss so user intent wins
if [[ "${PB_GODSEYE}" == "1" || "${PB_GODSEYE}" == "true" || "${PB_GODSEYE}" == "on" ]]; then
  if [[ -n "$PY" && -f "$PRIVATE_BRAIN_HOME/scripts/godseye.py" ]]; then
    # start/restart single window (user asked via -GodsEye)
    "$PY" "$PRIVATE_BRAIN_HOME/scripts/godseye.py" start >/dev/null 2>&1 || true
  fi
fi

# NEVER replace codex — only exec it with hooks bypass + profile
if [[ "$INGEST_ONLY" == "1" ]]; then
  exit 0
fi
# Full system access required (mission): profile has danger-full-access + approval never.
# Also pass CLI bypass so sandbox helper never gates tool use.
# ( --nuclear still blocked as a separate "even more" flag under enterprise; this is baseline.)
if [[ "${PB_ENTERPRISE:-0}" == "1" || "${ENTERPRISE:-0}" == "1" || "$PROFILE" == "beast-enterprise" || "$PROFILE" == "beast" || "$PROFILE" == "beast-godseye" ]]; then
  # avoid duplicate flags
  has_bypass=0
  for x in "${EXTRA_CODEX[@]+"${EXTRA_CODEX[@]}"}"; do
    [[ "$x" == --dangerously-bypass-approvals-and-sandbox ]] && has_bypass=1
  done
  if [[ "$has_bypass" != "1" ]]; then
    EXTRA_CODEX+=(--dangerously-bypass-approvals-and-sandbox)
  fi
fi
# Safe empty-array expand under `set -u` (bash errors on "${arr[@]}" when arr is empty)
# GodsEye already started above when -GodsEye was set; this only launches Codex.
set +u
exec "$CODEX_BIN" --dangerously-bypass-hook-trust "${EXTRA_CODEX[@]}" -p "$PROFILE" "${PASSTHRU[@]}"
