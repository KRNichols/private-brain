# Copy to corporate-package-index.env and source before SETUP / pip.
# Replace URLs with your Corporate Library or Protected Gateway approved PyPI remote (ask platform eng).
# Preferred model: PIP_INDEX_URL → Corporate Library / Protected Gateway; request package if missing; core stdlib headless.
# Not the primary model: offline vendor/wheels kit. See CORPORATE_PACKAGE_INDEX.md + config/judge_corporate_library_policy.json.
#
#   cp corporate-package-index.env.example corporate-package-index.env
#   # edit URLs
#   source ./corporate-package-index.env
#   ./SETUP.command
#   # or: ./START_AT_CORPORATE.command

# Primary approved index (Corporate Library Corporate Package Index or Protected Gateway — virtual repo of approved packages only)
export PIP_INDEX_URL="https://REPLACE.corporate-library.corporate-package-index.example/corporate-package-index/api/pypi/pypi-virtual/simple"
export PIP_TRUSTED_HOST="REPLACE.corporate-library.corporate-package-index.example"
# Protected Gateway example:
# export PIP_INDEX_URL="https://REPLACE.protected-gateway.example/corporate-package-index/api/pypi/pypi-virtual/simple"
# export PIP_TRUSTED_HOST="REPLACE.protected-gateway.example"

# Private Brain SETUP reads these aliases too:
export PB_PIP_INDEX_URL="${PIP_INDEX_URL}"
export PB_PIP_TRUSTED_HOST="${PIP_TRUSTED_HOST}"

# Enterprise: do not fall back to public pypi.org
export PB_ENTERPRISE=1
export PB_PIP_REQUIRE_CORPORATE_INDEX=1

# Optional auth (prefer netrc / keyring when available)
# export PIP_INDEX_URL="https://user:token@REPLACE.../simple"
